# Copy this file to .env if you want to override any default.
# Never commit your actual .env file to version control.

# Host/port the FastAPI/uvicorn server binds to.
HOST=0.0.0.0
PORT=8000

# Logging verbosity. One of: DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO

# Max downloads yt-dlp will run at the same time.
MAX_CONCURRENT_DOWNLOADS=2

# Reject videos longer than this (seconds) before downloading them.
# 0 disables the check.
MAX_VIDEO_DURATION_SECONDS=21600
